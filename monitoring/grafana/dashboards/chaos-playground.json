    {
      "id": 8,
      "type": "timeseries",
      "title": "Aufrufe der Zahlung, mit Schutz",
      "description": "Was der Shop mit Schutz mit jeder Zahlung macht. Erfolgreich: Zahlung angefragt und rechtzeitig bestätigt. Fehlgeschlagen: Zahlung angefragt, aber Fehler oder nach 1 Sekunde keine Antwort. Abgewiesen: Zahlung gar nicht erst angefragt, weil sie gerade als kaputt gilt. Das schont die Zahlung und spart der Kundschaft das Warten.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(resilience4j_circuitbreaker_calls_seconds_count{job=\"shop-resilient\",kind=\"successful\"}[$__rate_interval])) > 0",
          "legendFormat": "erfolgreich",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(resilience4j_circuitbreaker_calls_seconds_count{job=\"shop-resilient\",kind=\"failed\"}[$__rate_interval])) > 0",
          "legendFormat": "fehlgeschlagen",
