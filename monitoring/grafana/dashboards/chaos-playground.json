{
  "uid": "chaos-playground",
  "title": "Chaos Playground",
  "tags": [
    "chaos-playground"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Anteil beantworteter Bestellungen",
      "description": "Wie viele Bestellungen eine Antwort bekommen. Auch \"Zahlung wird nachgeholt\" zählt als Antwort, denn die Kundschaft weiß dann, woran sie ist. Wird die Zahlung langsam, fällt der Shop ohne Schutz auf null: Er wartet auf die Zahlung, bis die Kundschaft aufgibt. Der Shop mit Schutz bleibt bei 100 %, weil er nicht ewig wartet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(loadgenerator_orders_seconds_count{target=\"shop-plain\",result=~\"201|202\"}[$__rate_interval])) or vector(0)) / sum(rate(loadgenerator_orders_seconds_count{target=\"shop-plain\"}[$__rate_interval]))",
          "legendFormat": "ohne Schutz",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(loadgenerator_orders_seconds_count{target=\"shop-resilient\",result=~\"201|202\"}[$__rate_interval])) or vector(0)) / sum(rate(loadgenerator_orders_seconds_count{target=\"shop-resilient\"}[$__rate_interval]))",
          "legendFormat": "mit Schutz",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ohne Schutz"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B23A8A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mit Schutz"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2F6FD0"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Antwortzeit",
      "description": "Wie lange die Kundschaft auf eine Antwort wartet. Durchgezogen ist der Durchschnitt, gestrichelt die Zeit, die 95 von 100 Bestellungen nicht überschreiten. Ohne Schutz steigt sie bis 10 Sekunden, denn so lange wartet der Lastgenerator, bevor er aufgibt. Mit Schutz bleibt sie bei wenigen Millisekunden, weil der Shop die langsame Zahlung nicht mehr abwartet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loadgenerator_orders_seconds_sum{target=\"shop-plain\"}[$__rate_interval])) / sum(rate(loadgenerator_orders_seconds_count{target=\"shop-plain\"}[$__rate_interval]))",
          "legendFormat": "ohne Schutz, Durchschnitt",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loadgenerator_orders_seconds_sum{target=\"shop-resilient\"}[$__rate_interval])) / sum(rate(loadgenerator_orders_seconds_count{target=\"shop-resilient\"}[$__rate_interval]))",
          "legendFormat": "mit Schutz, Durchschnitt",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loadgenerator_orders_seconds_bucket{target=\"shop-plain\"}[$__rate_interval])))",
          "legendFormat": "ohne Schutz, p95",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loadgenerator_orders_seconds_bucket{target=\"shop-resilient\"}[$__rate_interval])))",
          "legendFormat": "mit Schutz, p95",
          "refId": "D",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ohne Schutz, Durchschnitt"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B23A8A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mit Schutz, Durchschnitt"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2F6FD0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ohne Schutz, p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B23A8A"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mit Schutz, p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2F6FD0"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ergebnisse pro Sekunde, ohne Schutz",
      "description": "Was mit jeder Bestellung an den Shop ohne Schutz passiert. 201: bestellt und bezahlt. 502: Zahlung oder Lager melden einen Fehler, und der Shop gibt ihn weiter. timeout: keine Antwort innerhalb von 10 Sekunden. connection_error: der Shop ist gar nicht erreichbar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(loadgenerator_orders_seconds_count{target=\"shop-plain\"}[$__rate_interval])) > 0",
          "legendFormat": "{{result}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
