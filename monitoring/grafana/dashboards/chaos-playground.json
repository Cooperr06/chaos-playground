    {
      "id": 6,
      "type": "timeseries",
      "title": "Belegte Threads im Shop",
      "description": "Ein Shop kann nur eine bestimmte Zahl von Bestellungen gleichzeitig bearbeiten, hier 20 (gestrichelte Linie). Ohne Schutz hängt jede dieser 20 an der langsamen Zahlung, danach kommt keine Bestellung mehr durch, auch keine, die mit der Zahlung nichts zu tun hätte. Ein Problem in einem Dienst legt so den ganzen Shop lahm.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(tomcat_threads_busy_threads{job=\"shop-plain\",name=\"http-nio-8080\"})",
          "legendFormat": "ohne Schutz",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
